    "task_config": "configs/reach_grasp_lift.json",
    "hand_synergies": "configs/wuji_hand_left_synergies.json",
    "grasp_stage_config": "configs/grasp_secure_stage.json"
  },
  "stages": {
    "reach": {
      "type": "ACT",
      "checkpoint": "outputs/act_reach_only/act_train/checkpoints/002000/pretrained_model",
      "checkpoint_step": 2000,
      "gate": "pregrasp position error <= 12 mm for 5 consecutive frames"
    },
    "approach": {
      "type": "ACT",
      "checkpoint": "outputs/act_staged/approach_only/act_train/checkpoints/002000/pretrained_model",
      "checkpoint_step": 2000,
      "gate": "frozen ApproachPolicy terminal gate and cube-motion safety"
    },
    "recovery": {
      "type": "ACT",
      "checkpoint": "outputs/staged_act_with_recovery/recovery_act_train/checkpoints/001500/pretrained_model",
      "checkpoint_step": 1500,
      "router": "configs/recovery_router.json",
      "router_name": "selective_hysteresis",
      "maximum_attempts": 1
    },
    "grasp_secure": {
      "type": "ACT",
      "checkpoint": "outputs/grasp_preload_act/act_train/checkpoints/001500/pretrained_model",
      "checkpoint_step": 1500,
      "timeout_frames": 80,
      "static_gate_semantics": "diagnostic_only_for_lift_admission",
      "static_gate_reason": "forced-Lift evaluation found 42.9% precision and 27.0% success among gate failures",
      "terminal_validity": "finite qpos, qvel, ctrl, and cube pose"
    },
    "lift": {
      "type": "scripted",
      "implementation": "openarm_wuji.tasks.scripted_lift_handoff.run_scripted_lift_from_handoff",
      "config_source": "configs/reach_grasp_lift.json#lift",
      "terminal_hold_s": 1.0,
      "preserve_live_hand_target": true,
      "trained": false
    }
  },
  "lift_admission": {
    "require_graspsecure_static_gate": false,
    "require_finite_graspsecure_terminal": true,
    "prelift_cube_motion_safety_m": 0.025,
    "contact_topology_is_diagnostic_only": true,
    "force_is_diagnostic_only": true,
    "relative_drift_is_diagnostic_only": true
  },
  "benchmark": {
    "seed_start": 9000,
    "num_runs": 100,
    "fresh_relative_to_policy_training_and_selection": true,
    "representative_visualizations": true
  },
  "disabled_mechanisms": {
    "retry_enabled": false,
    "micro_lift_probe_enabled": false,
    "lift_act_enabled": false,
    "online_expert_action_enabled": false
